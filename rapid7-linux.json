{
  "schemaVersion": "2.2",
  "description": "Install the Rapid7 Insight Agent on Linux.",
  "parameters": {
    "source": {
      "type": "String",
      "description": "(Required) S3 path to the Rapid7 Linux installer script.",
      "default": "s3://your-bucket-name/installers/rapid7/agent_installer.sh"
    },
    "token": {
      "type": "String",
      "description": "(Required) Rapid7 Insight Agent token.",
      "default": "us:your-token-here"
    },
    "workingDirectory": {
      "type": "String",
      "default": "/tmp",
      "description": "(Optional) Working directory.",
      "maxChars": 4096
    },
    "executionTimeout": {
      "type": "String",
      "default": "600",
      "description": "(Optional) Seconds before the command times out. Default 600, max 172800.",
      "allowedPattern": "([1-9][0-9]{0,4})|(1[0-6][0-9]{4})|(17[0-1][0-9]{3})|(172[0-7][0-9]{2})|(172800)"
    }
  },
  "mainSteps": [
    {
      "action": "aws:runShellScript",
      "name": "InstallInsightAgent",
      "inputs": {
        "runCommand": [
          "sudo aws s3 cp {{ source }} /tmp/agent_installer.sh",
          "sudo chmod +x /tmp/agent_installer.sh",
          "sudo /tmp/agent_installer.sh install_start --token {{ token }}"
        ],
        "workingDirectory": "{{ workingDirectory }}",
        "timeoutSeconds": "{{ executionTimeout }}"
      }
    }
  ]
}
